{
  "datasets": [
    {
      "name": "gas_by_type",
      "displayName": "Gas por Tipo de Transação",
      "query": "SELECT\n  tx_type_semantic,\n  COUNT(*)                                                AS tx_count,\n  ROUND(AVG(gas_pct_of_block), 4)                        AS avg_gas_pct,\n  ROUND(AVG(CAST(gas_price AS DOUBLE) / 1e9), 4)        AS avg_gas_price_gwei,\n  ROUND(AVG(CAST(gas_limit AS DOUBLE)), 0)              AS avg_gas_limit\nFROM {{CATALOG}}.g_apps.ethereum_gas_consume\nWHERE tx_type_semantic IS NOT NULL\nGROUP BY tx_type_semantic\nORDER BY tx_count DESC"
    },
    {
      "name": "gas_hourly",
      "displayName": "Gas Price por Bloco e Tipo",
      "query": "SELECT\n  block_number,\n  tx_type_semantic,\n  ROUND(AVG(CAST(gas_price AS DOUBLE) / 1e9), 4)       AS avg_gas_price_gwei,\n  ROUND(AVG(gas_pct_of_block), 4)                       AS avg_gas_pct,\n  COUNT(*)                                               AS tx_count\nFROM {{CATALOG}}.g_apps.ethereum_gas_consume\nWHERE tx_type_semantic IS NOT NULL\nGROUP BY block_number, tx_type_semantic\nORDER BY block_number DESC\nLIMIT 2000"
    },
    {
      "name": "gas_price_daily",
      "displayName": "Percentis de Gas Price por Hora",
      "query": "SELECT\n  hour_bucket,\n  ROUND(AVG(gas_price_p50_gwei), 4) AS gas_price_p50_gwei,\n  ROUND(AVG(gas_price_p75_gwei), 4) AS gas_price_p75_gwei,\n  ROUND(AVG(gas_price_p95_gwei), 4) AS gas_price_p95_gwei,\n  SUM(tx_count)                    AS tx_count\nFROM {{CATALOG}}.g_apps.gas_price_distribution_hourly\nGROUP BY hour_bucket\nORDER BY hour_bucket ASC\nLIMIT 720"
    }
  ],
